@page "/"
@rendermode InteractiveServer
@using NvidiaChatBot.Services
@using NvidiaChatBot.Models
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@inject ChatMemoryService MemoryService
@inject NvidiaAiService AiService
@inject IJSRuntime JSRuntime

<PageTitle>NVIDIA AI Chat</PageTitle>

<div class="chat-wrapper">
    <div class="chat-container">
        <div class="chat-header">
            <div class="header-content">
                <div class="header-logo">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
                </div>
                <div>
                    <h3 class="m-0">NVIDIA Nemotron</h3>
                    <small class="session-id">Session: @SessionId.Substring(0, 8)</small>
                </div>
            </div>
        </div>

        <div class="chat-messages" id="chat-messages-container">
            @if(Messages.Count == 0)
            {
                <div class="empty-state">
                    <h4>How can I help you today?</h4>
                    <p>Ask a question or upload a document to get started.</p>
                </div>
            }

            @foreach (var msg in Messages)
            {
                <div class="message-row @(msg.Role == "user" ? "user-row" : "ai-row")">
                    <div class="message-bubble @(msg.Role == "user" ? "user-message" : "ai-message")">
                        <div class="message-role">@(msg.Role == "user" ? "You" : "Assistant")</div>
                        
                        @if (!string.IsNullOrEmpty(msg.ReasoningText))
                        {
                            <div class="reasoning-box">
                                <details>
                                    <summary>Reasoning Process</summary>
                                    <div class="reasoning-content">@msg.ReasoningText</div>
                                </details>
                            </div>
                        }

                        <div class="message-content markdown-body">
                            @((MarkupString)Markdown.ToHtml(msg.DisplayText, Pipeline))
                        </div>
                    </div>
                </div>
            }
            @if (IsLoading)
            {
                <div class="message-row ai-row">
                    <div class="message-bubble ai-message">
                        <div class="message-role">Assistant</div>
                        <div class="typing-indicator">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="chat-input-area">
            <div class="input-container">
                @if (!string.IsNullOrEmpty(_uploadedFileContext))
                {
                    <div class="attached-file-badge">
                        <span class="file-icon">📎</span>
                        <span class="file-name">@_uploadedFileName</span>
                        <button @onclick="ClearFile" class="btn-clear" title="Remove file">×</button>
                    </div>
                }

                <div class="input-row">
                    <label for="file-upload" class="btn-attach" title="Attach file (PDF, DOCX, XLSX, TXT)">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                        <InputFile id="file-upload" OnChange="HandleFileUpload" style="display: none;" />
                    </label>

                    <textarea @bind="CurrentInput" @bind:event="oninput" @onkeydown="HandleKeyDown" 
                              placeholder="Ask a question..." rows="1" class="chat-input" id="chatInputArea"></textarea>
                    
                    <button @onclick="SendMessage" disabled="@(string.IsNullOrWhiteSpace(CurrentInput) && string.IsNullOrEmpty(_uploadedFileContext) || IsLoading)" class="btn-send">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                </div>
            </div>
            <div class="footer-text">
                NVIDIA Nemotron can make mistakes. Verify important information.
            </div>
        </div>
    </div>
</div>

<style>
    body {
        margin: 0;
        padding: 0;
        background-color: #f3f4f6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .chat-wrapper {
        display: flex;
        justify-content: center;
        height: 100vh;
        width: 100vw;
        padding: 20px;
        box-sizing: border-box;
    }

    .chat-container {
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 900px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .chat-header {
        background: linear-gradient(135deg, #76b900 0%, #5c9000 100%);
        color: white;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        z-index: 10;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-logo {
        background: rgba(255,255,255,0.2);
        padding: 8px;
        border-radius: 8px;
        display: flex;
    }

    .chat-header h3 { 
        margin: 0; 
        font-size: 1.2rem;
        font-weight: 600;
    }

    .session-id {
        font-size: 0.8rem;
        opacity: 0.8;
    }

    .chat-messages {
        flex-grow: 1;
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
        background-color: #f9fafb;
    }

    .empty-state {
        margin: auto;
        text-align: center;
        color: #6b7280;
    }

    .empty-state h4 {
        font-size: 1.5rem;
        color: #374151;
        margin-bottom: 8px;
    }

    .message-row {
        display: flex;
        width: 100%;
    }

    .user-row {
        justify-content: flex-end;
    }

    .ai-row {
        justify-content: flex-start;
    }

    .message-bubble {
        max-width: 80%;
        padding: 12px 18px;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .user-message {
        background-color: #f3f4f6;
        color: #1f2937;
        border-bottom-right-radius: 4px;
    }

    .ai-message {
        background-color: #ffffff;
        color: #1f2937;
        border: 1px solid #e5e7eb;
        border-bottom-left-radius: 4px;
    }

    .message-role {
        font-size: 0.75rem;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .reasoning-box {
        background-color: #f8fafc;
        border-left: 3px solid #76b900;
        padding: 8px 12px;
        margin-bottom: 12px;
        border-radius: 0 4px 4px 0;
        font-size: 0.85rem;
        color: #475569;
    }

    details > summary {
        cursor: pointer;
        font-weight: 500;
        color: #334155;
    }
    
    details > summary:hover {
        color: #76b900;
    }

    .reasoning-content {
        margin-top: 8px;
        white-space: pre-wrap;
    }

    .chat-input-area {
        padding: 16px 24px;
        background-color: #ffffff;
        border-top: 1px solid #e5e7eb;
    }

    .input-container {
        display: flex;
        flex-direction: column;
        background: #f3f4f6;
        border-radius: 12px;
        padding: 8px 12px;
        border: 1px solid #e5e7eb;
        transition: border-color 0.2s;
    }
    
    .input-container:focus-within {
        border-color: #76b900;
        background: #ffffff;
        box-shadow: 0 0 0 2px rgba(118, 185, 0, 0.1);
    }

    .input-row {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .chat-input {
        flex-grow: 1;
        resize: none;
        padding: 8px 0;
        border: none;
        background: transparent;
        font-family: inherit;
        font-size: 1rem;
        max-height: 150px;
        overflow-y: auto;
    }
    
    .chat-input:focus {
        outline: none;
    }

    .btn-attach {
        background: transparent;
        color: #6b7280;
        padding: 8px;
        border-radius: 50%;
        cursor: pointer;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, color 0.2s;
    }
    
    .btn-attach:hover {
        background-color: #e5e7eb;
        color: #374151;
    }

    .btn-send {
        background-color: #76b900;
        color: white;
        border: none;
        padding: 8px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, transform 0.1s;
        margin-bottom: 4px;
    }
    
    .btn-send:hover:not(:disabled) {
        background-color: #649c00;
        transform: scale(1.05);
    }

    .btn-send:disabled {
        background-color: #d1d5db;
        cursor: not-allowed;
    }

    .attached-file-badge {
        display: inline-flex;
        align-items: center;
        background-color: #e5e7eb;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        margin-bottom: 8px;
        color: #374151;
        width: fit-content;
    }

    .btn-clear {
        background: none;
        border: none;
        color: #ef4444;
        font-weight: bold;
        cursor: pointer;
        margin-left: 8px;
        font-size: 1rem;
        display: flex;
        align-items: center;
        padding: 0 4px;
    }

    .footer-text {
        text-align: center;
        font-size: 0.75rem;
        color: #9ca3af;
        margin-top: 12px;
    }

    /* Typing indicator */
    .typing-indicator {
        display: flex;
        gap: 4px;
        padding: 4px 0;
    }

    .typing-indicator span {
        width: 6px;
        height: 6px;
        background-color: #9ca3af;
        border-radius: 50%;
        animation: typing 1.4s infinite ease-in-out both;
    }

    .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }

    @@keyframes typing {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }
    
    /* Markdown Adjustments */
    .markdown-body pre {
        background-color: #1e1e1e;
        color: #d4d4d4;
        padding: 12px;
        border-radius: 6px;
        overflow-x: auto;
    }
    .markdown-body code {
        font-family: 'Consolas', 'Courier New', monospace;
        background-color: rgba(0,0,0,0.05);
        padding: 2px 4px;
        border-radius: 3px;
        font-size: 0.9em;
    }
    .markdown-body pre code {
        background-color: transparent;
        padding: 0;
    }
    .markdown-body p:last-child {
        margin-bottom: 0;
    }
</style>

@code {
    private string SessionId = Guid.NewGuid().ToString("N");
    private List<ChatMessage> Messages = new();
    private string CurrentInput = "";
    private bool IsLoading = false;

    private string _uploadedFileContext = "";
    private string _uploadedFileName = "";

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
    
    protected override void OnInitialized()
    {
        // Load existing session messages if any
        Messages = MemoryService.GetOrCreateSession(SessionId).Messages;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _uploadedFileName = file.Name;
        // Limit to 10MB for this demo
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        _uploadedFileContext = await FileParserUtil.ParseFileAsync(memoryStream, file.Name);
    }

    private void ClearFile()
    {
        _uploadedFileContext = "";
        _uploadedFileName = "";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(CurrentInput) && string.IsNullOrEmpty(_uploadedFileContext)) return;

        IsLoading = true;
        StateHasChanged();

        var prompt = CurrentInput;
        if (!string.IsNullOrEmpty(_uploadedFileContext))
        {
            prompt += $"\n\n[Attached File Content: {_uploadedFileName}]\n{_uploadedFileContext}";
        }

        var userMessage = new ChatMessage
        {
            Role = "user",
            Content = prompt,
            DisplayText = CurrentInput + (!string.IsNullOrEmpty(_uploadedFileContext) ? $"\n\n*(Attached file: {_uploadedFileName})*" : "")
        };

        MemoryService.AddMessageToSession(SessionId, userMessage);
        
        CurrentInput = "";
        ClearFile();

        var aiMessage = new ChatMessage
        {
            Role = "assistant",
            Content = "",
            DisplayText = "",
            ReasoningText = ""
        };
        MemoryService.AddMessageToSession(SessionId, aiMessage);

        var history = MemoryService.GetRecentHistory(SessionId); // Retrieves up to last 5 pairs (10 msgs)
        // Note: we just added the assistant message, so we should exclude it from history being sent to API
        var apiHistory = history.Take(history.Count - 1).ToList(); 
        
        // Remove the user message from history for the API call because we pass it separately
        var lastUserMsg = apiHistory.Last();
        apiHistory.RemoveAt(apiHistory.Count - 1);

        try
        {
            await foreach (var chunk in AiService.StreamChatAsync(apiHistory, lastUserMsg))
            {
                if (!string.IsNullOrEmpty(chunk.ReasoningChunk))
                {
                    aiMessage.ReasoningText += chunk.ReasoningChunk;
                }
                if (!string.IsNullOrEmpty(chunk.ContentChunk))
                {
                    aiMessage.DisplayText += chunk.ContentChunk;
                    aiMessage.Content = aiMessage.DisplayText;
                }
                
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
        }
        catch (Exception ex)
        {
            aiMessage.DisplayText += $"\n\n**Error:** {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chat-messages-container");
        }
        catch { }
    }
}
